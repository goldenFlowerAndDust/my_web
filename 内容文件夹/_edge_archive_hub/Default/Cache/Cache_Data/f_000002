:root {
    color-scheme: light;
    --bg: #f3f6fc;
    --bg-soft: #e9eefb;
    --surface: rgba(255, 255, 255, 0.86);
    --surface-solid: #ffffff;
    --surface-soft: #f7f9ff;
    --text: #172033;
    --muted: #65718a;
    --faint: #8d98ad;
    --line: rgba(23, 32, 51, 0.09);
    --line-strong: rgba(23, 32, 51, 0.15);
    --primary: #425fe8;
    --primary-2: #7b4df5;
    --teal: #0f9f8f;
    --amber: #db8a1f;
    --rose: #d94f70;
    --shadow-sm: 0 8px 24px rgba(33, 48, 88, 0.06);
    --shadow-md: 0 18px 50px rgba(33, 48, 88, 0.09);
    --shadow-lg: 0 30px 80px rgba(33, 48, 88, 0.15);
    --radius-sm: 12px;
    --radius-md: 18px;
    --radius-lg: 28px;
    --content-width: 1380px;
    --font-sans: "Noto Sans SC", "Source Han Sans SC", "Microsoft YaHei",
    "PingFang SC", "Hiragino Sans GB", sans-serif;
    --font-serif: "Noto Serif SC", "Source Han Serif SC", "Songti SC", SimSun,
    serif;
    --font-mono: "Cascadia Code", "SFMono-Regular", Consolas, monospace;
}

html[data-theme="dark"] {
    color-scheme: dark;
    --bg: #090f1d;
    --bg-soft: #101a2e;
    --surface: rgba(18, 27, 45, 0.84);
    --surface-solid: #121b2d;
    --surface-soft: #0e1728;
    --text: #e8edf7;
    --muted: #a0aec2;
    --faint: #7e8ca3;
    --line: rgba(255, 255, 255, 0.09);
    --line-strong: rgba(255, 255, 255, 0.16);
    --primary: #7f9bff;
    --primary-2: #b49bff;
    --teal: #5de0cf;
    --amber: #f2be63;
    --rose: #ff8aa4;
    --shadow-sm: 0 8px 24px rgba(0, 0, 0, 0.18);
    --shadow-md: 0 18px 50px rgba(0, 0, 0, 0.26);
    --shadow-lg: 0 30px 80px rgba(0, 0, 0, 0.36);
}

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 150px;
}

body {
    min-width: 320px;
    margin: 0;
    color: var(--text);
    background: radial-gradient(circle at 8% -5%, rgba(92, 119, 255, 0.16), transparent 34rem),
    radial-gradient(circle at 96% 8%, rgba(132, 88, 255, 0.12), transparent 32rem),
    linear-gradient(180deg, var(--bg) 0%, var(--bg-soft) 58%, var(--bg) 100%);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

body::before {
    position: fixed;
    inset: 0;
    z-index: -3;
    pointer-events: none;
    content: "";
    background-image: linear-gradient(var(--line) 1px, transparent 1px),
    linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 72px 72px;
    opacity: 0.24;
    mask-image: linear-gradient(to bottom, black, transparent 78%);
}

::selection {
    color: #fff;
    background: var(--primary);
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input {
    font: inherit;
}

button {
    color: inherit;
}

:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--primary) 70%, transparent);
    outline-offset: 3px;
}

.ambient-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    pointer-events: none;
}

.ambient-orb {
    position: absolute;
    width: 28rem;
    height: 28rem;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.18;
    animation: drift 18s ease-in-out infinite alternate;
}

.ambient-orb.one {
    top: -10rem;
    left: -7rem;
    background: #5e7cff;
}

.ambient-orb.two {
    top: 28rem;
    right: -12rem;
    background: #9b6cff;
    animation-delay: -6s;
}

.ambient-orb.three {
    bottom: -12rem;
    left: 30%;
    background: #39cfc1;
    animation-delay: -12s;
}

.math-float {
    position: absolute;
    color: color-mix(in srgb, var(--primary) 34%, transparent);
    font-family: var(--font-serif);
    font-size: clamp(22px, 3vw, 48px);
    font-style: italic;
    font-weight: 600;
    animation: float-symbol 14s ease-in-out infinite;
}

.math-float:nth-child(4n + 1) {
    animation-delay: -3s;
}

.math-float:nth-child(4n + 2) {
    animation-delay: -7s;
}

.math-float:nth-child(4n + 3) {
    animation-delay: -10s;
}

.scroll-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 200;
    height: 3px;
    background: transparent;
}

.scroll-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--teal), var(--primary), var(--primary-2));
    box-shadow: 0 0 18px color-mix(in srgb, var(--primary) 58%, transparent);
    transition: width 0.12s linear;
}

.page-shell {
    width: min(calc(100% - 40px), var(--content-width));
    margin: 0 auto;
    padding: 34px 0 80px;
}

.site-hero {
    position: relative;
    isolation: isolate;
    min-height: 350px;
    overflow: hidden;
    padding: clamp(34px, 5vw, 68px);
    color: #f7f9ff;
    background: linear-gradient(120deg, rgba(22, 36, 72, 0.98), rgba(50, 49, 118, 0.96) 52%, rgba(43, 37, 91, 0.98)),
    #172044;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 34px;
    box-shadow: var(--shadow-lg);
}

.site-hero::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    background: radial-gradient(circle at 80% 10%, rgba(104, 191, 255, 0.34), transparent 34%),
    radial-gradient(circle at 10% 100%, rgba(123, 77, 245, 0.44), transparent 42%),
    linear-gradient(115deg, transparent 0 38%, rgba(255, 255, 255, 0.045) 38% 38.2%, transparent 38.2%);
}

.site-hero::after {
    position: absolute;
    right: 4%;
    bottom: -118px;
    z-index: -1;
    content: "∫";
    color: rgba(255, 255, 255, 0.065);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(280px, 36vw, 520px);
    font-style: italic;
    line-height: 1;
    transform: rotate(-8deg);
    pointer-events: none;
}

.hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 230px;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
}

.hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    width: fit-content;
    margin-bottom: 20px;
    padding: 7px 12px;
    color: rgba(255, 255, 255, 0.78);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
}

.hero-eyebrow::before {
    width: 7px;
    height: 7px;
    content: "";
    background: #71e4d4;
    border-radius: 50%;
    box-shadow: 0 0 0 5px rgba(113, 228, 212, 0.12);
}

.hero-copy h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(46px, 7vw, 88px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.055em;
}

.hero-copy p {
    max-width: 760px;
    margin: 20px 0 0;
    color: rgba(237, 242, 255, 0.72);
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.8;
}

.hero-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
}

.hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.hero-stat {
    min-width: 112px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.075);
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 16px;
    backdrop-filter: blur(12px);
}

.hero-stat strong {
    display: block;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 22px;
    line-height: 1.2;
}

.hero-stat span {
    display: block;
    margin-top: 3px;
    color: rgba(236, 242, 255, 0.57);
    font-size: 11px;
    letter-spacing: 0.08em;
}

.hero-signature {
    color: rgba(255, 255, 255, 0.34);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
}

.sticky-tools {
    position: sticky;
    top: 12px;
    z-index: 80;
    margin: 26px 0 28px;
    padding: 10px;
    background: color-mix(in srgb, var(--surface-solid) 78%, transparent);
    border: 1px solid var(--line);
    border-radius: 22px;
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(22px) saturate(140%);
}

.toolbar-main {
    display: flex;
    align-items: center;
    gap: 10px;
}

.search-box {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    color: var(--muted);
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.search-box:focus-within {
    border-color: color-mix(in srgb, var(--primary) 55%, var(--line));
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--primary) 10%, transparent);
}

.search-icon {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1;
    transform: rotate(-18deg);
}

.search-box input {
    width: 100%;
    min-width: 0;
    height: 48px;
    padding: 0;
    color: var(--text);
    background: transparent;
    border: 0;
    outline: 0;
}

.search-box input::placeholder {
    color: var(--faint);
}

.search-box kbd {
    padding: 3px 7px;
    color: var(--faint);
    background: var(--surface-solid);
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
}

.theme-toggle {
    display: inline-flex;
    height: 48px;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    color: var(--text);
    background: var(--surface-solid);
    border: 1px solid var(--line);
    border-radius: 14px;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
}

.theme-toggle:hover {
    border-color: color-mix(in srgb, var(--primary) 50%, var(--line));
    transform: translateY(-1px);
}

.theme-toggle .theme-icon {
    color: var(--primary);
    font-size: 18px;
}

.section-nav {
    display: flex;
    gap: 6px;
    padding: 9px 2px 0;
    overflow-x: auto;
    border-top: 1px solid var(--line);
    margin-top: 9px;
    scrollbar-width: none;
}

.section-nav::-webkit-scrollbar {
    display: none;
}

.section-nav a {
    flex: 0 0 auto;
    padding: 7px 11px;
    color: var(--muted);
    border-radius: 9px;
    font-size: 12px;
    font-weight: 650;
    white-space: nowrap;
    transition: color 0.2s ease, background 0.2s ease;
}

.section-nav a:hover,
.section-nav a.is-active {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 9%, transparent);
}

.categories {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 22px;
}

.category-card {
    position: relative;
    grid-column: span 4;
    min-width: 0;
    padding: 24px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(16px);
    opacity: 1;
    transform: none;
    transition: box-shadow 0.25s ease,
    border-color 0.25s ease;
}

.category-card.is-visible {
    opacity: 1;
    transform: translateY(0);
}

.category-card:hover {
    border-color: color-mix(in srgb, var(--accent, var(--primary)) 30%, var(--line));
    box-shadow: var(--shadow-md);
}

.category-card::before {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    content: "";
    background: linear-gradient(90deg, var(--accent, var(--primary)), transparent 78%);
    opacity: 0.82;
}

.category-card.is-wide {
    grid-column: span 12;
    padding: 28px;
}

.category-card[data-accent="mint"] {
    --accent: var(--teal);
    --accent-soft: color-mix(in srgb, var(--teal) 9%, transparent);
}

.category-card[data-accent="blue"] {
    --accent: var(--primary);
    --accent-soft: color-mix(in srgb, var(--primary) 9%, transparent);
}

.category-card[data-accent="violet"] {
    --accent: var(--primary-2);
    --accent-soft: color-mix(in srgb, var(--primary-2) 9%, transparent);
}

.category-card[data-accent="amber"] {
    --accent: var(--amber);
    --accent-soft: color-mix(in srgb, var(--amber) 10%, transparent);
}

.category-card[data-accent="rose"] {
    --accent: var(--rose);
    --accent-soft: color-mix(in srgb, var(--rose) 9%, transparent);
}

.category-card > h2 {
    position: relative;
    display: flex;
    min-height: 52px;
    align-items: center;
    gap: 13px;
    margin: 0 0 20px;
    padding-bottom: 17px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-serif);
    font-size: clamp(20px, 2vw, 27px);
    line-height: 1.35;
    letter-spacing: -0.025em;
}

.category-card > h2::before {
    display: grid;
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    place-items: center;
    content: attr(data-icon);
    color: var(--accent, var(--primary));
    background: var(--accent-soft, color-mix(in srgb, var(--primary) 9%, transparent));
    border: 1px solid color-mix(in srgb, var(--accent, var(--primary)) 18%, transparent);
    border-radius: 13px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 22px;
    font-style: italic;
    letter-spacing: 0;
}

.category-card > h2::after {
    margin-left: auto;
    padding: 4px 9px;
    content: attr(data-count) " 项";
    color: var(--faint);
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
}

.module-list,
.link-list {
    margin: 0;
    padding: 0;
    list-style: none;
}

.module-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(258px, 1fr));
    gap: 14px;
}

.module-item {
    position: relative;
    min-width: 0;
    padding: 16px;
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    transition: transform 0.22s ease,
    background 0.22s ease,
    border-color 0.22s ease;
}

.module-item:hover {
    background: var(--surface-solid);
    border-color: color-mix(in srgb, var(--accent, var(--primary)) 26%, var(--line));
    transform: translateY(-2px);
}

.module-item::before {
    position: absolute;
    top: 18px;
    right: 16px;
    content: attr(data-index);
    color: color-mix(in srgb, var(--accent, var(--primary)) 48%, transparent);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
}

.module-item h3 {
    min-height: 3.1em;
    margin: 0 30px 12px 0;
    color: var(--text);
    font-size: 14px;
    font-weight: 750;
    line-height: 1.55;
}

.resource-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.resource-links a {
    display: inline-flex;
    min-height: 33px;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    color: var(--muted);
    background: var(--surface-solid);
    border: 1px solid var(--line);
    border-radius: 9px;
    font-size: 11px;
    font-weight: 650;
    transition: color 0.18s ease,
    border-color 0.18s ease,
    background 0.18s ease,
    transform 0.18s ease;
}

.resource-links a::before {
    width: 6px;
    height: 6px;
    content: "";
    background: var(--primary);
    border-radius: 50%;
}

.resource-links a[href$=".md"]::before {
    background: var(--amber);
}

.resource-links a[href$=".html"]::before {
    background: var(--teal);
}

.resource-links a:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--accent, var(--primary)) 8%, var(--surface-solid));
    border-color: color-mix(in srgb, var(--accent, var(--primary)) 30%, var(--line));
    transform: translateY(-1px);
}

.link-list {
    display: grid;
    gap: 9px;
}

.link-list li {
    min-width: 0;
}

.link-list a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 14px;
    color: var(--muted);
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 13px;
    font-size: 13px;
    font-weight: 650;
    transition: color 0.18s ease,
    border-color 0.18s ease,
    background 0.18s ease,
    transform 0.18s ease;
}

.link-list a::before {
    display: grid;
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    place-items: center;
    content: "↗";
    color: var(--accent, var(--primary));
    background: var(--accent-soft, color-mix(in srgb, var(--primary) 9%, transparent));
    border-radius: 8px;
    font-size: 13px;
}

.link-list a::after {
    margin-left: auto;
    content: "→";
    color: var(--faint);
    font-size: 14px;
    transition: transform 0.18s ease;
}

.link-list a:hover {
    color: var(--text);
    background: var(--surface-solid);
    border-color: color-mix(in srgb, var(--accent, var(--primary)) 28%, var(--line));
    transform: translateX(2px);
}

.link-list a:hover::after {
    transform: translateX(4px);
}

.empty-state {
    display: none;
    padding: 64px 24px;
    color: var(--muted);
    background: var(--surface);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    text-align: center;
}

.empty-state.is-visible {
    display: block;
}

.empty-state strong {
    display: block;
    margin-bottom: 6px;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 22px;
}

.is-hidden {
    display: none !important;
}

.page-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 34px;
    padding: 20px 6px 0;
    color: var(--faint);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
}

.back-to-top {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 90;
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    color: var(--text);
    background: color-mix(in srgb, var(--surface-solid) 92%, transparent);
    border: 1px solid var(--line);
    border-radius: 50%;
    box-shadow: var(--shadow-md);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: opacity 0.22s ease,
    transform 0.22s ease,
    visibility 0.22s ease,
    border-color 0.2s ease;
    backdrop-filter: blur(14px);
}

.back-to-top.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.back-to-top:hover {
    border-color: color-mix(in srgb, var(--primary) 42%, var(--line));
}

/* ===== 题型内嵌列表 ===== */
.category-card.is-question-types {
    grid-column: span 12;
    padding: 28px;
    background:
    radial-gradient(120% 150% at 100% 0%, color-mix(in srgb, var(--rose) 10%, transparent), transparent 55%),
    var(--surface);
    border-color: color-mix(in srgb, var(--rose) 18%, var(--line));
}

.category-card.is-question-types::before {
    height: 4px;
    background: linear-gradient(90deg, var(--rose), var(--primary-2), transparent 82%);
}

.category-card.is-question-types > h2 {
    margin-bottom: 8px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
}

.category-card.is-question-types > h2::after {
    content: attr(data-count) " 章";
}

.type-intro {
    margin: -2px 0 18px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
}

/* 一个题型容器可以放多个章节分组：极限、连续、导数…… */
.question-type-groups {
    display: grid;
    gap: 22px;
}

.question-type-group {
    min-width: 0;
}

.question-type-group + .question-type-group {
    padding-top: 20px;
    border-top: 1px solid var(--line);
}

.type-group-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
}

.type-group-heading {
    min-width: 0;
}

.type-group-kicker {
    display: block;
    margin-bottom: 2px;
    color: var(--accent, var(--primary));
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
}

.type-group-title {
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -0.02em;
}

.type-group-meta {
    padding: 4px 10px;
    color: var(--muted);
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 10px;
    white-space: nowrap;
}

.type-group-desc {
    margin: 4px 0 14px;
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.65;
}

.question-type-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
}

.category-card.is-question-types .question-type-item {
    display: flex;
    min-height: 190px;
    flex-direction: column;
    gap: 7px;
    padding: 15px 15px 13px;
    background: color-mix(in srgb, var(--surface-solid) 72%, transparent);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow-sm);
}

.category-card.is-question-types .question-type-item::before {
    display: none;
}

.category-card.is-question-types .question-type-item:hover {
    background: var(--surface-solid);
    border-color: color-mix(in srgb, var(--accent, var(--primary)) 30%, var(--line));
    box-shadow: var(--shadow-md);
}

.type-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
}

.type-index {
    color: var(--accent, var(--primary));
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
}

.type-range {
    padding: 2px 7px;
    color: var(--muted);
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.02em;
}

.type-level {
    padding: 2px 7px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 9.5px;
    font-weight: 750;
}

.type-level[data-level="基础"] {
    color: var(--teal);
    background: color-mix(in srgb, var(--teal) 10%, transparent);
    border-color: color-mix(in srgb, var(--teal) 18%, transparent);
}

.type-level[data-level="进阶"] {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 9%, transparent);
    border-color: color-mix(in srgb, var(--primary) 17%, transparent);
}

.type-level[data-level="易错"] {
    color: var(--rose);
    background: color-mix(in srgb, var(--rose) 9%, transparent);
    border-color: color-mix(in srgb, var(--rose) 17%, transparent);
}

.type-level[data-level="综合"] {
    color: var(--primary-2);
    background: color-mix(in srgb, var(--primary-2) 9%, transparent);
    border-color: color-mix(in srgb, var(--primary-2) 17%, transparent);
}

.type-count {
    margin-left: auto;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9.5px;
}

.category-card.is-question-types .question-type-item h3 {
    min-height: 0;
    margin: 0;
    padding: 0;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 14.5px;
    font-weight: 750;
    line-height: 1.45;
}

.type-desc {
    flex: 1;
    margin: 0;
    color: var(--muted);
    font-size: 11.8px;
    line-height: 1.6;
}

.type-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
}

.type-link {
    display: inline-flex;
    min-height: 29px;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 5px 8px;
    color: var(--muted);
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 10.5px;
    font-weight: 700;
    white-space: nowrap;
    transition: color 0.18s ease,
    border-color 0.18s ease,
    background 0.18s ease,
    transform 0.18s ease;
}

.type-link .type-arrow {
    color: var(--faint);
    font-size: 11px;
    transition: transform 0.18s ease;
}

.type-link:hover {
    color: var(--text);
    background: var(--surface-solid);
    border-color: color-mix(in srgb, var(--accent, var(--primary)) 30%, var(--line));
    transform: translateY(-1px);
}

.type-link:hover .type-arrow {
    transform: translateX(2px);
}

.type-link[data-kind="question"] {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 8%, var(--surface-soft));
    border-color: color-mix(in srgb, var(--primary) 18%, var(--line));
}

.type-link[data-kind="solution"] {
    color: var(--teal);
    background: color-mix(in srgb, var(--teal) 8%, var(--surface-soft));
    border-color: color-mix(in srgb, var(--teal) 18%, var(--line));
}

.type-link[data-kind="pdf"] {
    color: var(--amber);
    background: color-mix(in srgb, var(--amber) 9%, var(--surface-soft));
    border-color: color-mix(in srgb, var(--amber) 20%, var(--line));
}

.type-board-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
}

.type-summary {
    color: var(--muted);
    font-size: 12px;
}

.type-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.type-actions .type-link {
    padding: 7px 12px;
    background: var(--surface-solid);
    font-size: 11px;
}

@keyframes drift {
    from {
        transform: translate3d(-2%, -2%, 0) scale(1);
    }
    to {
        transform: translate3d(4%, 5%, 0) scale(1.12);
    }
}

@keyframes float-symbol {
    0%,
    100% {
        transform: translateY(0) rotate(-4deg);
        opacity: 0.35;
    }
    50% {
        transform: translateY(-17px) rotate(4deg);
        opacity: 0.68;
    }
}

@media (max-width: 1120px) {
    .category-card {
        grid-column: span 6;
    }

    .question-type-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .category-card.is-wide {
        grid-column: span 12;
    }

    .hero-signature {
        display: none;
    }
}

@media (max-width: 760px) {
    html {
        scroll-padding-top: 172px;
    }

    .page-shell {
        width: min(calc(100% - 24px), var(--content-width));
        padding-top: 14px;
    }

    .site-hero {
        min-height: 320px;
        padding: 30px 24px;
        border-radius: 24px;
    }

    .hero-content {
        min-height: 250px;
    }

    .hero-copy h1 {
        font-size: clamp(42px, 16vw, 64px);
    }

    .hero-footer {
        align-items: flex-start;
        flex-direction: column;
    }

    .hero-stat {
        min-width: 100px;
        padding: 10px 13px;
    }

    .sticky-tools {
        top: 8px;
        margin-top: 16px;
        border-radius: 18px;
    }

    .toolbar-main {
        align-items: stretch;
    }

    .search-box {
        padding-inline: 12px;
    }

    .search-box kbd {
        display: none;
    }

    .theme-toggle {
        width: 48px;
        justify-content: center;
        padding: 0;
    }

    .theme-toggle .theme-label {
        display: none;
    }

    .category-card {
        grid-column: span 12;
        padding: 21px;
        border-radius: 22px;
    }

    .category-card.is-wide {
        padding: 21px;
    }

    .category-card.is-question-types {
        padding: 21px;
    }

    .type-group-head {
        align-items: flex-start;
    }

    .type-group-title {
        font-size: 21px;
    }

    .type-group-desc {
        margin-bottom: 12px;
    }

    .category-card.is-question-types .question-type-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .type-board-footer {
        align-items: flex-start;
        flex-direction: column;
    }

    .category-card > h2 {
        font-size: 21px;
    }

    .module-list {
        grid-template-columns: 1fr;
    }

    .category-card > h2::after {
        display: none;
    }

    .page-footer {
        align-items: flex-start;
        flex-direction: column;
    }
}

@media (max-width: 640px) {
    .category-card.is-question-types .question-type-list {
        grid-template-columns: none;
        grid-auto-flow: column;
        grid-auto-columns: clamp(250px, 78vw, 340px);
        overflow-x: auto;
        padding: 2px 2px 8px;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
    }

    .category-card.is-question-types .question-type-list::-webkit-scrollbar {
        display: none;
    }

    .category-card.is-question-types .question-type-item {
        min-height: 190px;
        scroll-snap-align: start;
    }

    .type-intro::after {
        content: " · 左右滑动查看";
        color: var(--faint);
    }
}

@media (max-width: 480px) {
    .site-hero {
        padding: 26px 20px;
    }

    .hero-copy p {
        font-size: 14px;
    }

    .hero-stats {
        gap: 7px;
    }

    .hero-stat {
        min-width: calc(50% - 4px);
    }

    .category-card {
        padding: 18px;
    }

    .module-item {
        padding: 14px;
    }

    .category-card.is-question-types .question-type-item {
        padding: 13px;
    }

    .type-group-title {
        font-size: 20px;
    }

    .type-group-meta {
        font-size: 9.5px;
    }

    .type-actions {
        width: 100%;
    }

    .type-actions .type-link {
        flex: 1 1 auto;
    }

    .resource-links {
        flex-direction: column;
    }

    .resource-links a {
        justify-content: flex-start;
    }
}

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}

@media print {
    body {
        background: #fff;
        color: #000;
    }

    body::before,
    .ambient-bg,
    .scroll-progress,
    .sticky-tools,
    .back-to-top {
        display: none !important;
    }

    .page-shell {
        width: 100%;
        padding: 0;
    }

    .site-hero {
        min-height: auto;
        color: #000;
        background: #fff;
        border: 1px solid #ccc;
        box-shadow: none;
    }

    .site-hero::before,
    .site-hero::after {
        display: none;
    }

    .hero-copy p,
    .hero-eyebrow,
    .hero-stat span,
    .hero-signature {
        color: #444;
    }

    .hero-stat {
        background: #fff;
        border-color: #ccc;
    }

    .categories {
        display: block;
    }

    .category-card {
        margin-bottom: 16px;
        break-inside: avoid;
        box-shadow: none;
        opacity: 1;
        transform: none;
    }

    .module-list {
        grid-template-columns: repeat(2, 1fr);
    }

    .is-question-types .type-links,
    .is-question-types .type-board-footer {
        display: none;
    }

    .type-group-head {
        align-items: flex-start;
    }

    .type-group-title {
        font-size: 14pt;
    }

    .is-question-types .question-type-item {
        min-height: 0;
        box-shadow: none;
    }
}

/* ===== 通用 AI 答疑窗口（数学 / 政治 / 信息技术共用） ===== */
.ai-tutor-launch {
    position: fixed;
    right: 22px;
    bottom: 82px;
    z-index: 95;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 15px;
    color: #fff;
    background: linear-gradient(135deg, var(--primary), var(--primary-2));
    border: 0;
    border-radius: 999px;
    box-shadow: var(--shadow-md);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.ai-tutor-launch:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

.ai-tutor-launch-icon {
    display: grid;
    width: 23px;
    height: 23px;
    place-items: center;
    color: var(--primary);
    background: rgba(255, 255, 255, 0.92);
    border-radius: 50%;
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1;
}

.ai-tutor-window {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    place-items: center;
    padding: 16px;
}

.ai-tutor-window[hidden] {
    display: none;
}

.ai-tutor-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 15, 30, 0.62);
    backdrop-filter: blur(5px);
}

.ai-tutor-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(1180px, calc(100vw - 32px));
    height: min(88vh, 900px);
    overflow: hidden;
    background: var(--surface-solid);
    border: 1px solid var(--line-strong);
    border-radius: 22px;
    box-shadow: var(--shadow-lg);
}

.ai-tutor-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px 12px 20px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
}

.ai-tutor-head-copy {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
}

.ai-tutor-kicker {
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    white-space: nowrap;
}

.ai-tutor-head h2 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(18px, 2.2vw, 26px);
    font-weight: 600;
    white-space: nowrap;
}

.ai-tutor-head-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

.ai-tutor-newtab {
    padding: 6px 9px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 11px;
    text-decoration: none;
    white-space: nowrap;
}

.ai-tutor-newtab:hover {
    color: var(--primary);
    border-color: var(--primary);
}

.ai-tutor-close {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 50%;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
}

.ai-tutor-close:hover {
    color: var(--primary);
    border-color: var(--primary);
}

.ai-tutor-frame {
    flex: 1;
    width: 100%;
    min-height: 0;
    background: var(--bg);
    border: 0;
}

.ai-tutor-fallback {
    color: var(--primary);
    font-weight: 700;
}

body.ai-tutor-open {
    overflow: hidden;
}

@media (max-width: 700px) {
    .ai-tutor-launch {
        right: 14px;
        bottom: 76px;
        padding: 10px 13px;
        font-size: 12px;
    }

    .ai-tutor-window {
        padding: 0;
        align-items: end;
    }

    .ai-tutor-panel {
        width: 100%;
        height: 92vh;
        border-radius: 18px 18px 0 0;
    }

    .ai-tutor-head {
        padding: 10px 10px 10px 14px;
    }

    .ai-tutor-head-copy {
        gap: 6px;
    }

    .ai-tutor-kicker {
        display: none;
    }

    .ai-tutor-newtab {
        font-size: 10px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .ai-tutor-launch {
        transition: none;
    }
}
